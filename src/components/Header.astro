---
import { ArrowUpRight, Blocks, GitBranch, Github, Menu, Moon, Sun, X } from 'lucide-astro'
import { site } from '../data/site'

const pathname = Astro.url.pathname
const links = [
  { href: '/projects/', label: '项目' },
  { href: '/skills/', label: 'Skills' },
  { href: '/knowledge/', label: '知识' },
]
---

<header class="site-header">
  <div class="site-header__inner shell">
    <a class="brand" href="/" aria-label="zp-home 首页">
      <span class="brand__mark">ZP</span>
      <span class="brand__name">zp-home</span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      {links.map((link) => (
        <a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <div class="header-actions__external">
        <a class="icon-button identity-action" href={site.skillhub} target="_blank" rel="noreferrer" title={`SkillHub ${site.skillhubHandle}`} aria-label={`打开 SkillHub ${site.skillhubHandle}`}>
          <Blocks size={18} />
        </a>
        <a class="icon-button identity-action" href={site.gitee} target="_blank" rel="noreferrer" title="Gitee yr_binary" aria-label="打开 Gitee yr_binary">
          <GitBranch size={18} />
        </a>
      </div>
      <a class="icon-button" href={site.github} target="_blank" rel="noreferrer" title="GitHub" aria-label="打开 GitHub">
        <Github size={18} />
      </a>
      <button class="icon-button" id="theme-toggle" type="button" title="切换主题" aria-label="切换深浅主题">
        <Sun class="theme-icon theme-icon--sun" size={18} />
        <Moon class="theme-icon theme-icon--moon" size={18} />
      </button>
      <button class="icon-button mobile-menu-button" id="menu-toggle" type="button" title="菜单" aria-label="打开导航" aria-expanded="false" aria-controls="mobile-nav">
        <Menu class="menu-icon menu-icon--open" size={20} />
        <X class="menu-icon menu-icon--close" size={20} />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航" hidden>
    <div class="mobile-nav__primary shell">
      {links.map((link, index) => (
        <a href={link.href} aria-current={pathname.startsWith(link.href) ? 'page' : undefined}>
          <span>0{index + 1}</span>
          <strong>{link.label}</strong>
          <ArrowUpRight size={19} aria-hidden="true" />
        </a>
      ))}
    </div>
    <div class="mobile-nav__external shell" aria-label="外部链接">
      <a href={site.github} target="_blank" rel="noreferrer">
        <Github size={17} aria-hidden="true" /> GitHub
      </a>
      <a href={site.skillhub} target="_blank" rel="noreferrer">
        <Blocks size={17} aria-hidden="true" /> SkillHub
      </a>
    </div>
  </nav>
</header>

<script>
  (() => {
    const root = document.documentElement
    const themeButton = document.querySelector<HTMLButtonElement>('#theme-toggle')
    const colorPreference = window.matchMedia('(prefers-color-scheme: dark)')
    const themeColor = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')

    const syncThemeControl = () => {
      const dark = root.dataset.theme === 'dark'
      const label = dark ? '切换为浅色主题' : '切换为深色主题'
      themeButton?.setAttribute('aria-label', label)
      themeButton?.setAttribute('title', label)
      themeColor?.setAttribute('content', dark ? '#171a16' : '#f3f5ed')
    }

    syncThemeControl()

    themeButton?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark'
      root.dataset.theme = next
      root.dataset.themeSource = 'stored'
      try {
        localStorage.setItem('theme', next)
      } catch {}
      syncThemeControl()
    })

    colorPreference.addEventListener('change', (event) => {
      if (root.dataset.themeSource !== 'system') return
      root.dataset.theme = event.matches ? 'dark' : 'light'
      syncThemeControl()
    })

    const header = document.querySelector<HTMLElement>('.site-header')
    const button = document.querySelector<HTMLButtonElement>('#menu-toggle')
    const nav = document.querySelector<HTMLElement>('#mobile-nav')

    const setMenu = (open: boolean, restoreFocus = false) => {
      if (!button || !nav) return
      button.setAttribute('aria-expanded', String(open))
      button.setAttribute('aria-label', open ? '关闭导航' : '打开导航')
      nav.hidden = !open
      document.body.classList.toggle('menu-open', open)
      if (!open && restoreFocus) button.focus()
    }

    button?.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true'
      setMenu(!expanded)
    })

    nav?.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false)
    })

    document.addEventListener('click', (event) => {
      if (button?.getAttribute('aria-expanded') !== 'true') return
      if (event.target instanceof Node && !header?.contains(event.target)) setMenu(false)
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
        setMenu(false, true)
      }
    })

    window.matchMedia('(min-width: 721px)').addEventListener('change', (event) => {
      if (event.matches) setMenu(false)
    })
  })()
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    height: var(--header);
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklch, var(--bg) 90%, transparent);
    backdrop-filter: blur(20px) saturate(120%);
  }

  .site-header__inner {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 28px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 760;
  }

  .brand__mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 5px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 11px;
    transition: transform 180ms var(--ease-out), background-color 180ms var(--ease-out);
  }

  .brand:hover .brand__mark {
    background: var(--accent-hover);
    transform: rotate(-4deg);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-left: auto;
  }

  .desktop-nav a {
    position: relative;
    padding-block: 24px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 680;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent-hover);
    content: '';
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms var(--ease-out);
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current='page'] {
    color: var(--ink);
  }

  .desktop-nav a:hover::after,
  .desktop-nav a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header-actions__external {
    display: flex;
    gap: 8px;
    margin-right: 4px;
    padding-right: 12px;
    border-right: 1px solid var(--line);
  }

  .mobile-menu-button,
  .mobile-nav {
    display: none;
  }

  .theme-icon--sun,
  :global(:root[data-theme='dark']) .theme-icon--moon {
    display: none;
  }

  :global(:root[data-theme='dark']) .theme-icon--sun {
    display: block;
  }

  .menu-icon--close,
  .mobile-menu-button[aria-expanded='true'] .menu-icon--open {
    display: none;
  }

  .mobile-menu-button[aria-expanded='true'] .menu-icon--close {
    display: block;
  }

  @media (max-width: 720px) {
    :global(body.menu-open) {
      overflow: hidden;
    }

    .site-header__inner {
      gap: 16px;
    }

    .identity-action {
      display: none;
    }

    .header-actions__external {
      display: none;
    }

    .desktop-nav {
      display: none;
    }

    .header-actions {
      margin-left: auto;
    }

    .mobile-menu-button {
      display: inline-grid;
    }

    .mobile-nav:not([hidden]) {
      display: block;
      position: absolute;
      top: var(--header);
      right: 0;
      left: 0;
      border-bottom: 1px solid var(--line);
      background: var(--bg);
      box-shadow: var(--shadow-strong);
      animation: menu-in 180ms var(--ease-out) both;
    }

    .mobile-nav__primary {
      padding-block: 12px;
    }

    .mobile-nav__primary a {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr) auto;
      align-items: center;
      min-height: 64px;
      padding-inline: 8px;
      border-bottom: 1px solid var(--line);
    }

    .mobile-nav__primary a:last-child {
      border-bottom: 0;
    }

    .mobile-nav__primary span {
      color: var(--cyan);
      font-family: 'JetBrains Mono Variable', monospace;
      font-size: 11px;
    }

    .mobile-nav__primary strong {
      font-size: 18px;
    }

    .mobile-nav__external {
      display: flex;
      gap: 20px;
      padding-block: 16px 24px;
      border-top: 1px solid var(--line);
    }

    .mobile-nav__external a {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      color: var(--muted);
      font-size: 14px;
      font-weight: 680;
    }

    @keyframes menu-in {
      from {
        opacity: 0;
        transform: translateY(-8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  @media (max-width: 390px) {
    .brand__name {
      display: none;
    }
  }
</style>
