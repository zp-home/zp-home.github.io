---
import { ArrowUpRight, Github } from 'lucide-astro'
import type { CollectionEntry } from 'astro:content'
import RepositoryMetrics from './RepositoryMetrics.astro'

interface Props {
  project: CollectionEntry<'projects'>
  eager?: boolean
}

const { project, eager = false } = Astro.props
---

<article class="project-card" data-tags={project.data.tags.join(' ').toLowerCase()}>
  <a class="project-card__image" href={`/projects/${project.id}/`} aria-label={`查看 ${project.data.title}`}>
    <img
      src={project.data.image}
      alt={`${project.data.title} 项目预览`}
      width="960"
      height="600"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
    />
  </a>
  <div class="project-card__body">
    <div class="project-card__meta">
      <span>{project.data.role}</span>
      <span>{project.data.status}</span>
    </div>
    <h2><a href={`/projects/${project.id}/`}>{project.data.title}</a></h2>
    <p>{project.data.summary}</p>
    <ul class="tag-list" aria-label="技术标签">
      {project.data.tags.slice(0, 4).map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <RepositoryMetrics repository={project.data.repository} compact />
    <div class="project-card__actions">
      <a href={`/projects/${project.id}/`}>项目记录 <ArrowUpRight size={16} /></a>
      <a href={project.data.repository} target="_blank" rel="noreferrer" title="GitHub" aria-label={`${project.data.title} GitHub 仓库`}>
        <Github size={18} />
      </a>
    </div>
  </div>
</article>

<style>
  .project-card {
    overflow: clip;
    border: 1px solid var(--line);
    border-radius: 7px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .project-card__image {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-2);
  }

  .project-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 260ms ease;
  }

  .project-card:hover .project-card__image img {
    transform: scale(1.018);
  }

  .project-card__body {
    padding: 24px;
  }

  .project-card__meta {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
  }

  h2 {
    margin: 15px 0 10px;
    font-size: 25px;
    line-height: 1.2;
    letter-spacing: 0;
  }

  p {
    min-height: 52px;
    margin: 0 0 18px;
    color: var(--muted);
  }

  .project-card__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .project-card__actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 680;
  }

  @media (max-width: 520px) {
    .project-card__body {
      padding: 20px;
    }

    p {
      min-height: 0;
    }
  }
</style>
