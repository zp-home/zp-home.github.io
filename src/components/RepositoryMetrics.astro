---
import { Download, GitFork, Star } from 'lucide-astro'
import { getRepositoryStats, parseRepository } from '../utils/github'

interface Props {
  compact?: boolean
  repository: string
}

const { compact = false, repository } = Astro.props
const reference = parseRepository(repository)
const stats = await getRepositoryStats(repository)
const baseUrl = reference?.baseUrl ?? repository
const providerLabel = reference?.provider === 'gitee' ? 'Gitee' : 'GitHub'
---

{stats && (
  <div
    class:list={['repository-metrics', { 'repository-metrics--compact': compact }]}
    aria-label={`${providerLabel} 仓库数据`}
    data-repository-metrics={reference ? `${reference.owner}/${reference.name}` : undefined}
    data-repository-provider={reference?.provider}
  >
    <a href={`${baseUrl}/stargazers`} target="_blank" rel="noreferrer" title={`查看 ${providerLabel} Stars`}>
      <Star size={compact ? 15 : 17} aria-hidden="true" />
      <strong data-repository-stat="stars">{stats.stars}</strong>
      <span>Star</span>
    </a>
    <a href={`${baseUrl}/forks`} target="_blank" rel="noreferrer" title={`查看 ${providerLabel} Forks`}>
      <GitFork size={compact ? 15 : 17} aria-hidden="true" />
      <strong data-repository-stat="forks">{stats.forks}</strong>
      <span>Fork</span>
    </a>
    {stats.downloads !== null && (
      <a href={`${baseUrl}/releases`} target="_blank" rel="noreferrer" title="查看 Release 下载">
        <Download size={compact ? 15 : 17} aria-hidden="true" />
        <strong data-repository-stat="downloads">{stats.downloads}</strong>
        <span>下载</span>
      </a>
    )}
  </div>
)}

<script>
  interface ClientRepositoryStats {
    cachedAt: number
    downloads: number | null
    forks: number
    stars: number
  }

  interface RepositoryResponse {
    forks_count: number
    stargazers_count: number
  }

  interface ReleaseResponse {
    assets: Array<{ download_count: number }>
  }

  const requests = new Map<string, Promise<ClientRepositoryStats | null>>()
  const groups = document.querySelectorAll<HTMLElement>('[data-repository-metrics]')

  function readCachedStats(provider: string, repository: string) {
    try {
      const cached = sessionStorage.getItem(`repository-stats:${provider}:${repository}`)
      if (!cached) return null
      const stats = JSON.parse(cached) as ClientRepositoryStats
      return Date.now() - stats.cachedAt < 60 * 60 * 1000 ? stats : null
    } catch {
      return null
    }
  }

  function fetchStats(provider: string, repository: string) {
    const key = `${provider}:${repository}`
    const cached = readCachedStats(provider, repository)
    if (cached) return Promise.resolve(cached)

    const active = requests.get(key)
    if (active) return active

    const apiBase = provider === 'gitee' ? 'https://gitee.com/api/v5/repos' : 'https://api.github.com/repos'
    const headers = { Accept: provider === 'gitee' ? 'application/json' : 'application/vnd.github+json' }
    const repositoryRequest = fetch(`${apiBase}/${repository}`, { headers })
    const releasesRequest = provider === 'github'
      ? fetch(`https://api.github.com/repos/${repository}/releases?per_page=100`, { headers })
      : Promise.resolve(null)

    const request = Promise.all([repositoryRequest, releasesRequest])
      .then(async ([repositoryResponse, releasesResponse]) => {
        if (!repositoryResponse.ok) return null
        const repositoryData = (await repositoryResponse.json()) as RepositoryResponse
        let downloads: number | null = null

        if (releasesResponse?.ok) {
          const releases = (await releasesResponse.json()) as ReleaseResponse[]
          downloads = releases.reduce(
            (total, release) => total + release.assets.reduce((sum, asset) => sum + asset.download_count, 0),
            0,
          )
        }

        const stats: ClientRepositoryStats = {
          cachedAt: Date.now(),
          downloads,
          forks: repositoryData.forks_count,
          stars: repositoryData.stargazers_count,
        }

        try {
          sessionStorage.setItem(`repository-stats:${provider}:${repository}`, JSON.stringify(stats))
        } catch {}
        return stats
      })
      .catch(() => null)

    requests.set(key, request)
    return request
  }

  for (const group of groups) {
    const repository = group.dataset.repositoryMetrics
    const provider = group.dataset.repositoryProvider
    if (!repository || !provider) continue

    fetchStats(provider, repository).then((stats) => {
      if (!stats) return
      for (const key of ['stars', 'forks', 'downloads'] as const) {
        const value = stats[key]
        const target = group.querySelector<HTMLElement>(`[data-repository-stat="${key}"]`)
        if (value !== null && target) target.textContent = String(value)
      }
    })
  }
</script>

<style>
  .repository-metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 24px;
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 13px;
  }

  .repository-metrics a {
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 6px;
  }

  .repository-metrics a:hover {
    color: var(--cyan);
  }

  .repository-metrics strong {
    color: var(--ink);
    font-size: 15px;
  }

  .repository-metrics--compact {
    gap: 14px;
    margin-top: 20px;
    font-size: 12px;
  }

  .repository-metrics--compact a {
    min-height: 26px;
  }

  .repository-metrics--compact strong {
    font-size: 13px;
  }

  @media (max-width: 390px) {
    .repository-metrics {
      gap: 12px;
    }

    .repository-metrics a {
      gap: 5px;
    }
  }
</style>
