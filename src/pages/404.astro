---
import { ArrowLeft } from 'lucide-astro'
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="404 | zp-home" description="页面不存在">
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1>这个页面还没有内容。</h1>
    <a class="button button--accent" href="/"><ArrowLeft size={17} /> 返回首页</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 68vh;
    padding-block: 120px;
  }

  h1 {
    max-width: 700px;
    margin: 0 0 34px;
    font-size: 58px;
    line-height: 1.08;
    letter-spacing: 0;
  }

  @media (max-width: 600px) {
    h1 {
      font-size: 40px;
    }
  }
</style>
