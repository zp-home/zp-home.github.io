---
import { getCollection } from 'astro:content'
import { ArrowRight, Search, X } from 'lucide-astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { byNewest, formatDate } from '../../utils/content'

const entries = (await getCollection('knowledge')).sort(byNewest)
---

<BaseLayout title="Knowledge | zp-home" description="来自项目实践、Agent Skills 与强化学习实验的知识记录。">
  <header class="page-intro shell">
    <p class="eyebrow">Knowledge</p>
    <h1>记录判断，不只记录结论</h1>
    <p class="page-intro__copy">每篇内容尽量保留问题、约束、替代方案和验证证据，方便以后更新而不是重新猜一次。</p>
  </header>

  <section class="section--compact shell">
    <div class="search-wrap">
      <label class="search-box" for="knowledge-search">
        <Search size={18} aria-hidden="true" />
        <input id="knowledge-search" type="search" placeholder="搜索标题、摘要或标签" autocomplete="off" aria-describedby="knowledge-status" />
      </label>
      <button class="icon-button search-clear" id="knowledge-clear" type="button" title="清除搜索" aria-label="清除搜索" hidden>
        <X size={18} aria-hidden="true" />
      </button>
    </div>
    <p class="search-status" id="knowledge-status" role="status" aria-live="polite">共 {entries.length} 条知识记录</p>

    <div class="content-list" id="knowledge-list">
      {entries.map((entry) => (
        <article class="content-row" data-search={`${entry.data.title} ${entry.data.summary} ${entry.data.tags.join(' ')}`.toLowerCase()}>
          <span class="content-row__meta">{formatDate(entry.data.date)} · {entry.data.readingTime}</span>
          <div>
            <h2><a href={`/knowledge/${entry.id}/`}>{entry.data.title}</a></h2>
            <p>{entry.data.summary}</p>
            <ul class="tag-list knowledge-tags">
              {entry.data.tags.map((tag) => <li class="tag">{tag}</li>)}
            </ul>
          </div>
          <a class="icon-button" href={`/knowledge/${entry.id}/`} title="阅读" aria-label={`阅读 ${entry.data.title}`}><ArrowRight size={18} /></a>
        </article>
      ))}
    </div>
    <p class="empty-state" id="knowledge-empty">没有匹配的知识条目。</p>
  </section>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#knowledge-search')
  const rows = [...document.querySelectorAll<HTMLElement>('[data-search]')]
  const empty = document.querySelector<HTMLElement>('#knowledge-empty')
  const clear = document.querySelector<HTMLButtonElement>('#knowledge-clear')
  const status = document.querySelector<HTMLElement>('#knowledge-status')

  const updateResults = () => {
    const query = input?.value.trim().toLowerCase() ?? ''
    let visible = 0
    for (const row of rows) {
      const matches = query.length === 0 || row.dataset.search?.includes(query)
      row.hidden = !matches
      if (matches) visible += 1
    }
    if (empty) empty.style.display = visible === 0 ? 'block' : 'none'
    if (clear) clear.hidden = query.length === 0
    if (status) status.textContent = query.length === 0
      ? `共 ${visible} 条知识记录`
      : `“${input?.value.trim()}”找到 ${visible} 条结果`
  }

  input?.addEventListener('input', updateResults)
  input?.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !input.value) return
    input.value = ''
    updateResults()
  })
  clear?.addEventListener('click', () => {
    if (!input) return
    input.value = ''
    updateResults()
    input.focus()
  })
</script>

<style>
  .content-row[hidden] {
    display: none;
  }

  .knowledge-tags {
    margin-top: 16px;
  }

  .search-wrap {
    display: flex;
    max-width: 616px;
    align-items: center;
    gap: 8px;
  }

  .search-box {
    width: 100%;
    margin-bottom: 0;
  }

  .search-clear[hidden] {
    display: none;
  }

  .search-status {
    margin: 12px 0 30px;
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
  }
</style>
