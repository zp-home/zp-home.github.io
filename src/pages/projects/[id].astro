---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowUpRight, Github } from 'lucide-astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate } from '../../utils/content'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }))
}

interface Props {
  project: CollectionEntry<'projects'>
}

const { project } = Astro.props
const { Content } = await render(project)
---

<BaseLayout title={`${project.data.title} | zp-home`} description={project.data.summary} image={project.data.image}>
  <article>
    <header class="project-header">
      <div class="shell project-header__content">
        <a class="back-link" href="/projects/"><ArrowLeft size={16} /> Projects</a>
        <p class="eyebrow">{project.data.role} · {project.data.status}</p>
        <h1>{project.data.title}</h1>
        <p class="project-header__summary">{project.data.summary}</p>
        <div class="button-row">
          <a class="button button--accent" href={project.data.repository} target="_blank" rel="noreferrer"><Github size={17} /> Repository</a>
          {project.data.website && (
            <a class="button" href={project.data.website} target="_blank" rel="noreferrer">Live site <ArrowUpRight size={17} /></a>
          )}
        </div>
        <div class="article-meta">
          <span>{formatDate(project.data.date)}</span>
          <span>{project.data.tags.join(' / ')}</span>
        </div>
      </div>
    </header>
    <div class="project-visual">
      <img src={project.data.image} alt={`${project.data.title} 项目预览`} width="1440" height="900" />
    </div>
    <div class="article-shell prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project-header {
    padding-block: 64px 52px;
  }

  .project-header__content {
    max-width: 1060px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 54px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
  }

  h1 {
    max-width: 900px;
    margin: 0;
    font-size: 64px;
    line-height: 1.04;
    letter-spacing: 0;
  }

  .project-header__summary {
    max-width: 760px;
    margin: 22px 0 28px;
    color: var(--muted);
    font-size: 20px;
  }

  .article-meta {
    margin-top: 34px;
  }

  .project-visual {
    width: min(calc(100% - 40px), 1320px);
    margin-inline: auto;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: 7px;
    background: var(--surface-2);
  }

  .project-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 720px) {
    .project-header {
      padding-block: 42px 36px;
    }

    .back-link {
      margin-bottom: 38px;
    }

    h1 {
      font-size: 43px;
    }

    .project-visual {
      width: calc(100% - 28px);
      aspect-ratio: 4 / 3;
    }
  }
</style>
