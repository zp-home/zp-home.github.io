---
import { getCollection } from 'astro:content'
import ProjectCard from '../../components/ProjectCard.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { byNewest } from '../../utils/content'

const projects = (await getCollection('projects')).sort(byNewest)
---

<BaseLayout title="Projects | zp-home" description="公开项目、开源协作和关键工程取舍。">
  <header class="page-intro shell">
    <p class="eyebrow">Projects</p>
    <h1>从真实约束里做产品</h1>
    <p class="page-intro__copy">个人项目与开源协作分别标注。每项尽量保留问题现象、错误假设、定位过程、验证证据和仍未关闭的风险。</p>
  </header>

  <section class="section--compact shell">
    <div class="filter-bar" role="group" aria-label="项目筛选">
      <button class="filter-button" type="button" data-filter="all" aria-pressed="true">全部</button>
      <button class="filter-button" type="button" data-filter="desktop">桌面与插件</button>
      <button class="filter-button" type="button" data-filter="agent">Agent 能力</button>
      <button class="filter-button" type="button" data-filter="automation">自动化</button>
    </div>
    <p class="filter-status" id="project-status" role="status" aria-live="polite">显示全部 {projects.length} 个项目</p>
    <div class="project-grid" id="project-grid" aria-describedby="project-status">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
    <p class="empty-state" id="project-empty">当前筛选下没有项目。</p>
  </section>
</BaseLayout>

<script>
  const aliases: Record<string, string[]> = {
    desktop: ['desktop', 'electron', 'plugin', 'typescript'],
    agent: ['agent', 'skills', 'interoperability'],
    automation: ['automation', 'pipeline', 'github actions', 'sandbox'],
  }

  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')]
  const cards = [...document.querySelectorAll<HTMLElement>('[data-tags]')]
  const empty = document.querySelector<HTMLElement>('#project-empty')
  const status = document.querySelector<HTMLElement>('#project-status')
  const labels = new Map(buttons.map((button) => [button.dataset.filter ?? 'all', button.textContent?.trim() ?? '全部']))

  const applyFilter = (filter: string, updateUrl = true) => {
    const activeFilter = labels.has(filter) ? filter : 'all'
    let visible = 0

    for (const candidate of buttons) {
      candidate.setAttribute('aria-pressed', String(candidate.dataset.filter === activeFilter))
    }
    for (const card of cards) {
      const matches = activeFilter === 'all' || aliases[activeFilter]?.some((tag) => card.dataset.tags?.includes(tag))
      card.hidden = !matches
      if (matches) visible += 1
    }

    if (empty) empty.style.display = visible === 0 ? 'block' : 'none'
    if (status) status.textContent = activeFilter === 'all'
      ? `显示全部 ${visible} 个项目`
      : `${labels.get(activeFilter)}：${visible} 个项目`

    if (updateUrl) {
      const url = new URL(window.location.href)
      if (activeFilter === 'all') url.searchParams.delete('filter')
      else url.searchParams.set('filter', activeFilter)
      history.replaceState({}, '', url)
    }
  }

  for (const [index, button] of buttons.entries()) {
    button.addEventListener('click', () => applyFilter(button.dataset.filter ?? 'all'))
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return
      event.preventDefault()
      const nextIndex = event.key === 'Home'
        ? 0
        : event.key === 'End'
          ? buttons.length - 1
          : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length
      buttons[nextIndex]?.focus()
      applyFilter(buttons[nextIndex]?.dataset.filter ?? 'all')
    })
  }

  applyFilter(new URL(window.location.href).searchParams.get('filter') ?? 'all', false)
</script>

<style>
  .filter-status {
    margin: -14px 0 24px;
    color: var(--muted);
    font-family: 'JetBrains Mono Variable', monospace;
    font-size: 12px;
  }
</style>
