---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import { ArrowLeft, ArrowUpRight, Blocks, Github } from 'lucide-astro'
import RepositoryMetrics from '../../components/RepositoryMetrics.astro'
import SkillHubMetrics from '../../components/SkillHubMetrics.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'
import { formatDate } from '../../utils/content'

export async function getStaticPaths() {
  const skills = await getCollection('skills')
  return skills.map((skill) => ({ params: { id: skill.id }, props: { skill } }))
}

interface Props {
  skill: CollectionEntry<'skills'>
}

const { skill } = Astro.props
const { Content } = await render(skill)
---

<BaseLayout title={`${skill.data.title} | Skills | zp-home`} description={skill.data.summary}>
  <article class="article-shell">
    <header class="article-header">
      <a class="back-link" href="/skills/"><ArrowLeft size={16} /> Skills</a>
      <p class="eyebrow">{skill.data.kind}</p>
      <h1>{skill.data.title}</h1>
      <p class="article-header__summary">{skill.data.summary}</p>
      <div class="article-meta">
        <span>{formatDate(skill.data.date)}</span>
        <span>触发：{skill.data.triggers.join(' / ')}</span>
      </div>
      <div class="button-row skill-links">
        {skill.data.skillhub && (
          <a class="button button--accent" href={skill.data.skillhub.url} target="_blank" rel="noreferrer"><Blocks size={17} /> SkillHub <ArrowUpRight size={15} /></a>
        )}
        {skill.data.repository && (
          <a class="button" href={skill.data.repository} target="_blank" rel="noreferrer"><Github size={17} /> GitHub <ArrowUpRight size={15} /></a>
        )}
      </div>
      {skill.data.skillhub && <SkillHubMetrics skillhub={skill.data.skillhub} />}
      {skill.data.repository && <RepositoryMetrics repository={skill.data.repository} />}
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 48px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 650;
  }

  .skill-links {
    margin-top: 26px;
  }
</style>
